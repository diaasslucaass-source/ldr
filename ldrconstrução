<div class="mensagem" id="mensagem"></div>

<script>
// FUNÇÕES BÁSICAS

const selecionar = (seletor) => document.querySelector(seletor);
const selecionarTodos = (seletor) => document.querySelectorAll(seletor);

let carrinho = [];
let temporizadorMensagem;

function avisar(texto) {
  const mensagem = selecionar("#mensagem");

  mensagem.textContent = texto;
  mensagem.classList.add("visivel");

  clearTimeout(temporizadorMensagem);

  temporizadorMensagem = setTimeout(() => {
    mensagem.classList.remove("visivel");
  }, 3000);
}

// ABRIR E FECHAR POP-UPS

function abrirModal(id) {
  selecionar(id).classList.add("ativo");
  document.body.style.overflow = "hidden";
}

function fecharModal(modal) {
  modal.classList.remove("ativo");

  if (!selecionar(".fundo-modal.ativo")) {
    document.body.style.overflow = "";
  }
}

selecionar("#abrirCadastro").addEventListener("click", () => {
  abrirModal("#modalCadastro");
});

selecionar("#cadastroRodape").addEventListener("click", (evento) => {
  evento.preventDefault();
  abrirModal("#modalCadastro");
});

selecionar("#abrirDepartamentos").addEventListener("click", () => {
  abrirModal("#modalDepartamentos");
});

selecionarTodos("[data-fechar]").forEach((botao) => {
  botao.addEventListener("click", () => {
    fecharModal(botao.closest(".fundo-modal"));
  });
});

selecionarTodos(".fundo-modal").forEach((modal) => {
  modal.addEventListener("click", (evento) => {
    if (evento.target === modal) {
      fecharModal(modal);
    }
  });
});

document.addEventListener("keydown", (evento) => {
  if (evento.key === "Escape") {
    selecionarTodos(".fundo-modal.ativo").forEach(fecharModal);
  }
});

// FORMATAÇÃO DO CEP

selecionar("#cep").addEventListener("input", (evento) => {
  let cep = evento.target.value.replace(/\D/g, "").slice(0, 8);

  if (cep.length > 5) {
    cep = cep.slice(0, 5) + "-" + cep.slice(5);
  }

  evento.target.value = cep;
});

// FORMATAÇÃO DO TELEFONE

selecionar("#telefone").addEventListener("input", (evento) => {
  let numero = evento.target.value.replace(/\D/g, "").slice(0, 11);

  if (numero.length > 10) {
    numero =
      "(" + numero.slice(0, 2) + ") " +
      numero.slice(2, 7) + "-" +
      numero.slice(7);
  } else if (numero.length > 6) {
    numero =
      "(" + numero.slice(0, 2) + ") " +
      numero.slice(2, 6) + "-" +
      numero.slice(6);
  } else if (numero.length > 2) {
    numero =
      "(" + numero.slice(0, 2) + ") " +
      numero.slice(2);
  }

  evento.target.value = numero;
});

// CADASTRO DEMONSTRATIVO

selecionar("#formCadastro").addEventListener("submit", (evento) => {
  evento.preventDefault();

  const nome = selecionar("#nome").value.trim();
  const cep = selecionar("#cep").value.replace(/\D/g, "");
  const telefone = selecionar("#telefone").value.replace(/\D/g, "");

  if (nome.length < 2 || cep.length !== 8 || telefone.length < 10) {
    avisar("Confira o nome, o CEP e o telefone.");
    return;
  }

  fecharModal(selecionar("#modalCadastro"));

  avisar("Formulário preenchido! Nenhum dado foi enviado.");

  evento.target.reset();
});

// BUSCA DE PRODUTOS

function buscarProdutos(termo) {
  const pesquisa = termo.trim().toLocaleLowerCase("pt-BR");
  let encontrados = 0;

  selecionarTodos(".produto").forEach((produto) => {
    const nome = produto.dataset.nome.toLocaleLowerCase("pt-BR");
    const texto = produto.innerText.toLocaleLowerCase("pt-BR");

    const corresponde =
      pesquisa === "" ||
      nome.includes(pesquisa) ||
      texto.includes(pesquisa);

    produto.style.display = corresponde ? "" : "none";

    if (corresponde) {
      encontrados++;
    }
  });

  selecionar("#produtos").scrollIntoView({
    behavior: "smooth",
    block: "start"
  });

  if (pesquisa && encontrados === 0) {
    avisar("Nenhum produto encontrado. Tente outra palavra.");
  } else if (pesquisa) {
    avisar(encontrados + " produto(s) encontrado(s).");
  }
}

selecionar("#formBusca").addEventListener("submit", (evento) => {
  evento.preventDefault();
  buscarProdutos(selecionar("#campoBusca").value);
});

// CLIQUE NAS CATEGORIAS

selecionarTodos("[data-categoria]").forEach((categoria) => {
  categoria.addEventListener("click", () => {
    const nome = categoria.dataset.categoria;
    selecionar("#campoBusca").value = nome;

    // Mostra todos os produtos da demonstração para categorias
    // que ainda não possuem uma lista comercial específica.
    buscarProdutos(nome);
  });
});

// CLIQUE NO MENU DE DEPARTAMENTOS

selecionarTodos("[data-escolha]").forEach((botao) => {
  botao.addEventListener("click", () => {
    const categoria = botao.dataset.escolha;

    fecharModal(selecionar("#modalDepartamentos"));

    selecionar("#campoBusca").value = categoria;
    buscarProdutos(categoria);
  });
});

// CARRINHO DEMONSTRATIVO

selecionarTodos("[data-produto]").forEach((botao) => {
  botao.addEventListener("click", () => {
    const produto = botao.dataset.produto;

    carrinho.push(produto);

    selecionar("#contadorCarrinho").textContent = carrinho.length;

    avisar("Interesse adicionado: " + produto);
  });
});

selecionar("#abrirCarrinho").addEventListener("click", () => {
  if (carrinho.length === 0) {
    avisar("Você ainda não adicionou produtos.");
    return;
  }

  avisar("Produtos: " + carrinho.join(", "));
});

// FORMULÁRIO DE NOVIDADES

selecionar("#formNewsletter").addEventListener("submit", (evento) => {
  evento.preventDefault();

  avisar("Cadastro demonstrativo concluído. Nenhum e-mail foi salvo.");

  evento.target.reset();
});

// CONTATO DEMONSTRATIVO

selecionar("#botaoWhatsApp").addEventListener("click", () => {
  avisar("Configure aqui o WhatsApp oficial da LDR Construção.");
});

selecionar("#contatoRodape").addEventListener("click", (evento) => {
  evento.preventDefault();
  avisar("Configure o telefone ou WhatsApp oficial da loja.");
});
</script>

