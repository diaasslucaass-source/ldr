<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LDR Construção | Tudo para sua obra</title>

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root {
  --roxo: #51218a;
  --roxo-escuro: #32105f;
  --laranja: #ff7a1a;
  --branco: #ffffff;
  --fundo: #f8f6fb;
  --texto: #282331;
  --cinza: #77717f;
  --borda: #e9e2f0;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: "DM Sans", sans-serif;
  color: var(--texto);
  background: var(--branco);
}

button, input {
  font: inherit;
}

button, a {
  cursor: pointer;
}

a {
  text-decoration: none;
}

button {
  border: none;
}

.linha-topo {
  background: var(--roxo-escuro);
  color: white;
  padding: 10px;
  text-align: center;
  font-size: 12px;
}

.linha-topo span {
  color: #ffad70;
  font-weight: 700;
}

/* CABEÇALHO */

header {
  background: white;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 4px 20px #32105f12;
}

.cabecalho {
  max-width: 1250px;
  margin: auto;
  padding: 18px 25px;
  display: flex;
  align-items: center;
  gap: 25px;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 235px;
}

.logo-simbolo {
  background: var(--roxo);
  color: white;
  border: 3px solid var(--laranja);
  border-radius: 12px;
  padding: 11px 7px;
  font-weight: 900;
  font-size: 17px;
}

.logo h2 {
  font: 900 23px Montserrat, sans-serif;
  color: var(--roxo);
  letter-spacing: -1px;
}

.logo h2 span {
  color: var(--laranja);
}

.logo small {
  display: block;
  color: var(--cinza);
  font-size: 9px;
  letter-spacing: 2px;
  margin-top: 4px;
}

.busca {
  display: flex;
  flex: 1;
  max-width: 570px;
}

.busca input {
  width: 100%;
  padding: 14px;
  border: 1px solid var(--borda);
  border-radius: 9px 0 0 9px;
  outline: none;
}

.busca input:focus {
  border-color: var(--roxo);
}

.busca button {
  background: var(--laranja);
  color: white;
  padding: 0 20px;
  border-radius: 0 9px 9px 0;
  font-size: 20px;
}

.acoes {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-left: auto;
}

.botao-acao {
  background: white;
  color: var(--roxo);
  padding: 9px;
  font-weight: 700;
  font-size: 12px;
}

.contador {
  display: inline-grid;
  place-items: center;
  background: var(--laranja);
  color: white;
  width: 20px;
  height: 20px;
  border-radius: 50%;
}

nav {
  border-top: 1px solid var(--borda);
}

.menu-navegacao {
  max-width: 1250px;
  margin: auto;
  padding: 0 25px;
  display: flex;
  align-items: center;
  gap: 28px;
  min-height: 50px;
}

.menu-navegacao a,
.menu-navegacao button {
  color: var(--roxo);
  background: transparent;
  font-weight: 700;
  font-size: 12px;
}

.menu-navegacao a:hover,
.menu-navegacao button:hover {
  color: var(--laranja);
}

.menu-departamentos {
  color: var(--laranja) !important;
}

/* BANNER PRINCIPAL */

.banner {
  background: linear-gradient(115deg, #32105f, #51218a 65%, #7042a3);
  color: white;
  overflow: hidden;
}

.banner-conteudo {
  max-width: 1250px;
  min-height: 410px;
  margin: auto;
  padding: 50px 25px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
}

.etiqueta {
  display: inline-block;
  color: #ffc18e;
  border: 1px solid #ffffff35;
  padding: 9px 14px;
  border-radius: 30px;
  font-size: 11px;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.banner h1 {
  font: 900 clamp(38px, 4.5vw, 61px)/1.08 Montserrat, sans-serif;
  letter-spacing: -2px;
  margin: 22px 0;
}

.banner h1 span {
  color: #ff9b4a;
}

.banner p {
  color: #e9dff2;
  font-size: 15px;
  line-height: 1.8;
  max-width: 470px;
  margin-bottom: 25px;
}

.botao {
  display: inline-block;
  padding: 14px 20px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 800;
  transition: .2s;
}

.botao-laranja {
  background: var(--laranja);
  color: white;
}

.botao-laranja:hover {
  background: #e96300;
  transform: translateY(-2px);
}

.botao-contorno {
  border: 1px solid #ffffff80;
  color: white;
  margin-left: 8px;
}

.banner-foto {
  position: relative;
  height: 315px;
  border: 5px solid #ffffff20;
  border-radius: 18px;
  overflow: hidden;
}

.banner-foto img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.foto-legenda {
  position: absolute;
  bottom: 15px;
  left: 15px;
  right: 15px;
  background: white;
  color: var(--roxo);
  padding: 15px;
  border-radius: 10px;
  font-weight: 800;
  font-size: 13px;
}

/* BENEFÍCIOS */

.beneficios {
  max-width: 1250px;
  margin: auto;
  padding: 22px 25px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.beneficio {
  border: 1px solid var(--borda);
  border-radius: 12px;
  padding: 17px 12px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.beneficio-icone {
  background: #f1e7fc;
  color: var(--roxo);
  padding: 12px;
  border-radius: 10px;
  font-size: 18px;
}

.beneficio strong {
  display: block;
  font-size: 12px;
}

.beneficio small {
  display: block;
  color: var(--cinza);
  margin-top: 4px;
  font-size: 10px;
}

/* SEÇÕES */

.secao {
  max-width: 1250px;
  margin: auto;
  padding: 42px 25px;
}

.subtitulo {
  color: var(--laranja);
  font-size: 10px;
  letter-spacing: 2px;
  text-transform: uppercase;
  font-weight: 800;
  margin-bottom: 8px;
}

.titulo-secao {
  color: var(--roxo-escuro);
  font: 800 27px Montserrat, sans-serif;
}

.descricao-secao {
  color: var(--cinza);
  font-size: 13px;
  margin-top: 9px;
  margin-bottom: 24px;
}

/* CATEGORIAS */

.categorias {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14px;
}

.categoria {
  background: white;
  border: 1px solid var(--borda);
  border-radius: 14px;
  padding: 22px 12px;
  text-align: center;
  transition: .2s;
}

.categoria:hover {
  transform: translateY(-4px);
  border-color: var(--roxo);
  box-shadow: 0 10px 30px #32105f15;
}

.categoria-icone {
  width: 60px;
  height: 60px;
  background: #f1e7fc;
  color: var(--roxo);
  border-radius: 16px;
  display: grid;
  place-items: center;
  margin: 0 auto 14px;
  font-size: 28px;
}

.categoria:nth-child(even) .categoria-icone {
  background: #fff0e5;
  color: var(--laranja);
}

.categoria h3 {
  font-size: 13px;
  margin-bottom: 7px;
}

.categoria p {
  color: var(--cinza);
  font-size: 11px;
  line-height: 1.5;
}

/* PROMOÇÃO */

.promocao {
  max-width: 1200px;
  margin: 15px auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: #fff0e5;
  border-radius: 18px;
  overflow: hidden;
}

.promocao-texto {
  padding: 38px;
}

.promocao h2 {
  color: var(--roxo-escuro);
  font: 900 30px Montserrat, sans-serif;
  margin: 14px 0;
}

.promocao p {
  font-size: 13px;
  line-height: 1.8;
  color: #625668;
  margin-bottom: 20px;
}

.promocao img {
  width: 100%;
  height: 100%;
  min-height: 250px;
  object-fit: cover;
}

/* PRODUTOS */

.produtos {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 17px;
}

.produto {
  border: 1px solid var(--borda);
  border-radius: 13px;
  overflow: hidden;
  transition: .2s;
  background: white;
}

.produto:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 30px #32105f18;
}

.produto img {
  width: 100%;
  height: 180px;
  object-fit: cover;
  background: var(--fundo);
}

.produto-info {
  padding: 15px;
}

.produto-categoria {
  color: var(--cinza);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.produto h3 {
  font-size: 14px;
  margin: 8px 0;
}

.preco {
  color: var(--roxo);
  font: 800 19px Montserrat, sans-serif;
}

.disponibilidade {
  display: block;
  color: #268451;
  font-size: 10px;
  margin: 12px 0;
}

.adicionar {
  width: 100%;
  background: var(--roxo);
  color: white;
  padding: 11px;
  border-radius: 7px;
  font-size: 11px;
  font-weight: 800;
}

.adicionar:hover {
  background: var(--laranja);
}

/* GALERIA DE OBRAS */

.galeria {
  display: grid;
  grid-template-columns: 1.2fr 1fr 1fr;
  gap: 15px;
}

.obra {
  height: 235px;
  position: relative;
  overflow: hidden;
  border-radius: 13px;
}

.obra img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: .3s;
}

.obra:hover img {
  transform: scale(1.05);
}

.obra-legenda {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 22px 15px 15px;
  color: white;
  background: linear-gradient(transparent, #211137e8);
}

.obra-legenda strong {
  font: 700 14px Montserrat, sans-serif;
}

/* NEWSLETTER */

.newsletter {
  background: var(--roxo);
  color: white;
  border-radius: 14px;
  padding: 28px;
  margin-top: 25px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.newsletter h3 {
  font: 800 19px Montserrat, sans-serif;
  margin-bottom: 8px;
}

.newsletter p {
  color: #e6d9f2;
  font-size: 12px;
}

.newsletter form {
  display: flex;
  gap: 8px;
}

.newsletter input {
  padding: 12px;
  border: 0;
  border-radius: 7px;
  min-width: 190px;
}

/* RODAPÉ */

footer {
  background: #211137;
  color: white;
  padding: 40px 25px 20px;
}

.rodape-conteudo {
  max-width: 1200px;
  margin: auto;
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 30px;
}

footer h3 {
  color: #ff9b4a;
  font: 800 17px Montserrat, sans-serif;
  margin-bottom: 15px;
}

footer h4 {
  font: 700 13px Montserrat, sans-serif;
  margin-bottom: 15px;
}

footer p, footer a {
  display: block;
  color: #d2c4df;
  font-size: 12px;
  line-height: 1.9;
}

footer a:hover {
  color: var(--laranja);
}

.copyright {
  text-align: center;
  border-top: 1px solid #ffffff20;
  margin-top: 30px;
  padding-top: 18px;
  color: #c2b2d1;
  font-size: 10px;
}

/* BOTÃO WHATSAPP */

.whatsapp {
  position: fixed;
  bottom: 22px;
  right: 22px;
  z-index: 20;
  width: 55px;
  height: 55px;
  border-radius: 50%;
  background: #20c968;
  color: white;
  font-size: 25px;
  box-shadow: 0 6px 25px #0002;
}

/* POP-UPS */

.fundo-modal {
  position: fixed;
  inset: 0;
  z-index: 50;
  background: #180b2dbb;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.fundo-modal.ativo {
  display: flex;
}

.modal {
  background: white;
  width: 100%;
  max-width: 460px;
  max-height: 90vh;
  overflow-y: auto;
  border-radius: 16px;
  animation: aparecer .2s ease;
}

.modal-topo {
  background: var(--roxo);
  color: white;
  padding: 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-topo h2 {
  font: 800 19px Montserrat, sans-serif;
}

.modal-topo p {
  color: #e6d9f2;
  font-size: 12px;
  margin-top: 7px;
}

.fechar {
  background: #ffffff20;
  color: white;
  width: 32px;
  height: 32px;
  border-radius: 7px;
  font-size: 21px;
}

.modal-corpo {
  padding: 24px;
}

.campo {
  margin-bottom: 16px;
}

.campo label {
  display: block;
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 7px;
}

.campo input {
  width: 100%;
  padding: 13px;
  border: 1px solid var(--borda);
  border-radius: 8px;
  outline: none;
}

.campo input:focus {
  border-color: var(--roxo);
}

.botao-enviar {
  width: 100%;
  padding: 14px;
  border-radius: 8px;
  background: var(--laranja);
  color: white;
  font-weight: 800;
}

.aviso {
  font-size: 10px;
  color: var(--cinza);
  line-height: 1.6;
  margin-top: 13px;
}

/* DEPARTAMENTOS DO POP-UP */

.lista-departamentos {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.item-departamento {
  border: 1px solid var(--borda);
  border-radius: 10px;
  padding: 15px;
  background: white;
  text-align: left;
  color: var(--roxo);
}

.item-departamento:hover {
  background: #f7f0ff;
  border-color: var(--roxo);
}

.item-departamento strong {
  display: block;
  font-size: 12px;
  margin-bottom: 6px;
}

.item-departamento small {
  color: var(--cinza);
  font-size: 10px;
}

.mensagem {
  position: fixed;
  bottom: 25px;
  left: 50%;
  transform: translate(-50%, 20px);
  opacity: 0;
  pointer-events: none;
  z-index: 100;
  background: #211137;
  color: white;
  padding: 14px 20px;
  border-radius: 9px;
  font-size: 12px;
  transition: .2s;
  text-align: center;
}

.mensagem.visivel {
  opacity: 1;
  transform: translate(-50%, 0);
}

@keyframes aparecer {
  from {opacity: 0; transform: translateY(10px)}
  to {opacity: 1; transform: translateY(0)}
}

/* RESPONSIVIDADE */

@media (max-width: 900px) {
  .cabecalho {
    flex-wrap: wrap;
    gap: 12px;
  }

  .busca {
    order: 3;
    flex-basis: 100%;
    max-width: none;
  }

  .banner-conteudo {
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .beneficios {
    grid-template-columns: 1fr 1fr;
  }

  .categorias {
    grid-template-columns: repeat(3, 1fr);
  }

  .produtos {
    grid-template-columns: 1fr 1fr;
  }

  .rodape-conteudo {
    grid-template-columns: 1fr 1fr;
  }

  .promocao {
    margin: 15px 25px;
  }
}

@media (max-width: 600px) {
  .cabecalho {
    padding: 14px;
  }

  .logo {
    min-width: auto;
  }

  .logo h2 {
    font-size: 18px;
  }

  .logo small {
    font-size: 7px;
  }

  .menu-navegacao {
    padding: 15px;
    gap: 18px;
    overflow-x: auto;
  }

  .menu-navegacao a,
  .menu-navegacao button {
    white-space: nowrap;
    font-size: 11px;
  }

  .banner-conteudo {
    grid-template-columns: 1fr;
    padding: 35px 20px;
  }

  .banner h1 {
    font-size: 42px;
  }

  .banner-foto {
    height: 230px;
  }

  .beneficios {
    padding: 15px;
    gap: 8px;
  }

  .beneficio {
    padding: 10px 7px;
  }

  .beneficio strong {
    font-size: 10px;
  }

  .beneficio small {
    font-size: 9px;
  }

  .secao {
    padding: 32px 16px;
  }

  .titulo-secao {
    font-size: 22px;
  }

  .categorias {
    grid-template-columns: 1fr 1fr;
    gap: 9px;
  }

  .promocao {
    grid-template-columns: 1fr;
    margin: 10px 16px;
  }

  .promocao-texto {
    padding: 25px;
  }

  .promocao img {
    height: 180px;
    min-height: auto;
  }

  .produtos {
    gap: 10px;
  }

  .produto img {
    height: 130px;
  }

  .produto-info {
    padding: 10px;
  }

  .produto h3 {
    font-size: 12px;
  }

  .preco {
    font-size: 15px;
  }

  .galeria {
    grid-template-columns: 1fr 1fr;
    gap: 9px;
  }

  .obra {
    height: 165px;
  }

  .obra:first-child {
    grid-column: span 2;
    height: 190px;
  }

  .newsletter {
    flex-direction: column;
    align-items: stretch;
    padding: 22px;
  }

  .newsletter form {
    flex-direction: column;
  }

  .newsletter input {
    width: 100%;
  }

  .rodape-conteudo {
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }

  .lista-departamentos {
    grid-template-columns: 1fr;
  }
}
</style>
</head>

<body>

<div class="linha-topo">
  Sua obra merece o melhor.
  <span>Consulte nossas condições especiais!</span>
</div>

<header>
  <div class="cabecalho">

    <a href="#" class="logo">
      <div class="logo-simbolo">LDR</div>
      <div>
        <h2><span>LDR</span> CONSTRUÇÃO</h2>
        <small>MATERIAIS PARA SUA OBRA</small>
      </div>
    </a>

    <form class="busca" id="formBusca">
      <input
        type="search"
        id="campoBusca"
        placeholder="Busque produtos, ferramentas e muito mais..."
        aria-label="Buscar produtos"
      >
      <button type="submit" aria-label="Buscar">⌕</button>
    </form>

    <div class="acoes">
      <button class="botao-acao" id="abrirCadastro">
        ♙ Entrar ou cadastrar-se
      </button>

      <button class="botao-acao" id="abrirCarrinho">
        🛒 <span class="contador" id="contadorCarrinho">0</span>
      </button>
    </div>

  </div>

  <nav>
    <div class="menu-navegacao">
      <button class="menu-departamentos" id="abrirDepartamentos">
        ☰ TODOS OS DEPARTAMENTOS
      </button>
      <a href="#categorias">Departamentos</a>
      <a href="#ofertas">Ofertas</a>
      <a href="#obras">Inspire-se</a>
      <a href="#rodape">Atendimento</a>
    </div>
  </nav>
</header>

<main>

  <!-- BANNER PRINCIPAL -->

  <section class="banner">
    <div class="banner-conteudo">

      <div>
        <span class="etiqueta">Tudo para construir e renovar</span>

        <h1>
          O próximo passo da sua obra
          <span>começa aqui.</span>
        </h1>

        <p>
          Materiais de qualidade, ferramentas para todo projeto
          e soluções práticas para tirar suas ideias do papel.
        </p>

        <a href="#ofertas" class="botao botao-laranja">
          Ver ofertas →
        </a>

        <a href="#categorias" class="botao botao-contorno">
          Explorar produtos
        </a>
      </div>

      <div class="banner-foto">
        <img
          src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1000&q=85"
          alt="Profissionais trabalhando em uma obra"
        >

        <div class="foto-legenda">
          Do alicerce ao acabamento: vamos construir!
        </div>
      </div>

    </div>
  </section>

  <!-- BENEFÍCIOS -->

  <section class="beneficios">

    <div class="beneficio">
      <div class="beneficio-icone">✓</div>
      <div>
        <strong>Qualidade selecionada</strong>
        <small>Produtos para sua obra</small>
      </div>
    </div>

    <div class="beneficio">
      <div class="beneficio-icone">⌂</div>
      <div>
        <strong>Entrega ou retirada</strong>
        <small>Consulte as opções</small>
